#include <SFSE/SFSE.h>

// Horizon's copy of CommonLibSF's plugin version block. The fourth PluginVersion component is the
// file-version build from src/hz_version.h (HZ_FILE_VERSION_BUILD), not a literal 0. The settings
// schema (0.42.0) is not this version. SFSE::Init prints these four numbers.
SFSE_PLUGIN_VERSION = []() noexcept {
    SFSE::PluginVersionData v{};
    v.PluginVersion({ ${COMMONLIB_PLUGIN_VERSION_MAJOR}, ${COMMONLIB_PLUGIN_VERSION_MINOR}, ${COMMONLIB_PLUGIN_VERSION_PATCH}, ${HZ_FILE_VERSION_BUILD} });
    v.PluginName("${COMMONLIB_PLUGIN_NAME}");
    v.AuthorName("${COMMONLIB_PLUGIN_AUTHOR}");
    v.UsesSigScanning(${COMMONLIBSF_OPTION_SIG_SCANNING});
    v.UsesAddressLibrary(${COMMONLIBSF_OPTION_ADDRESS_LIBRARY});
    v.HasNoStructUse(${COMMONLIBSF_OPTION_NO_STRUCT_USE});
    v.IsLayoutDependent(${COMMONLIBSF_OPTION_LAYOUT_DEPENDENT});
    v.CompatibleVersions({ SFSE::RUNTIME_LATEST });
    v.MinimumRequiredXSEVersion({ ${COMMONLIB_PLUGIN_XSE_VERSION_MAJOR}, ${COMMONLIB_PLUGIN_XSE_VERSION_MINOR}, ${COMMONLIB_PLUGIN_XSE_VERSION_PATCH}, 0 });
    return v;
}();
