// Horizon UI version resource (used instead of CommonLibSF's commonlib-plugin.rc.in; see xmake.lua).
// CompanyName and LegalCopyright are the plugin author from xmake.lua.
// File version and product version both come from src/hz_version.h (0.42.0.4). Do not type the numbers here.
#include <winres.h>
#include "hz_version.h"

1 VERSIONINFO
FILEVERSION HZ_FILE_VERSION_MAJOR, HZ_FILE_VERSION_MINOR, HZ_FILE_VERSION_PATCH, HZ_FILE_VERSION_BUILD
PRODUCTVERSION HZ_FILE_VERSION_MAJOR, HZ_FILE_VERSION_MINOR, HZ_FILE_VERSION_PATCH, HZ_FILE_VERSION_BUILD
FILEFLAGSMASK 0x17L
#ifdef _DEBUG
    FILEFLAGS 0x1L
#else
    FILEFLAGS 0x0L
#endif
FILEOS 0x4L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "${COMMONLIB_PLUGIN_CONTACT}"
            VALUE "CompanyName", "${COMMONLIB_PLUGIN_AUTHOR}"
            VALUE "FileDescription", "${COMMONLIB_PLUGIN_DESCRIPTION}"
            VALUE "FileVersion", HZ_FILE_VERSION_STR
            VALUE "InternalName", "${COMMONLIB_PLUGIN_NAME}"
            VALUE "LegalCopyright", "${COMMONLIB_PLUGIN_AUTHOR}"
            VALUE "LegalTrademarks", "${COMMONLIB_PLUGIN_LICENSE}"
            VALUE "OriginalFilename", "${COMMONLIB_PLUGIN_NAME}.dll"
            VALUE "ProductName", "${COMMONLIB_PROJECT_NAME}"
            VALUE "ProductVersion", HZ_FILE_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
