// Horizon Ship Builder version resource. Product name is not the HUD product.
#include <winres.h>
#include "hsb_version.h"

1 VERSIONINFO
FILEVERSION HSB_FILE_VERSION_MAJOR, HSB_FILE_VERSION_MINOR, HSB_FILE_VERSION_PATCH, HSB_FILE_VERSION_BUILD
PRODUCTVERSION HSB_FILE_VERSION_MAJOR, HSB_FILE_VERSION_MINOR, HSB_FILE_VERSION_PATCH, HSB_FILE_VERSION_BUILD
FILEFLAGSMASK 0x17L
#ifdef _DEBUG
    FILEFLAGS 0x1L
#else
    FILEFLAGS 0x0L
#endif
FILEOS 0x4L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "${COMMONLIB_PLUGIN_CONTACT}"
            VALUE "CompanyName", "${COMMONLIB_PLUGIN_AUTHOR}"
            VALUE "FileDescription", "Horizon Ship Builder"
            VALUE "FileVersion", HSB_FILE_VERSION_STR
            VALUE "InternalName", "${COMMONLIB_PLUGIN_NAME}"
            VALUE "LegalCopyright", "${COMMONLIB_PLUGIN_AUTHOR}"
            VALUE "LegalTrademarks", "${COMMONLIB_PLUGIN_LICENSE}"
            VALUE "OriginalFilename", "${COMMONLIB_PLUGIN_NAME}.dll"
            VALUE "ProductName", "Horizon Ship Builder"
            VALUE "ProductVersion", HSB_FILE_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
